# ── Angel One SmartAPI Credentials ────────────────────────────────────
ANGEL_API_KEY=your_smartapi_key_here
ANGEL_CLIENT_ID=your_client_code_here
ANGEL_PIN=your_4_digit_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_key_here

# ── Fyers API v3 Credentials ──────────────────────────────────────────
FYERS_CLIENT_ID=your_fyers_app_id_here
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_REDIRECT_URI=http://127.0.0.1:5000/callback
FYERS_TOTP_KEY=your_totp_key_here
FYERS_PIN=your_4digit_pin_here
FYERS_ACCESS_TOKEN=your_access_token_here

# ── Upstox API Credentials ───────────────────────────────────────────
UPSTOX_CLIENT_ID=your_api_key_here
UPSTOX_CLIENT_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback
UPSTOX_TOTP_SECRET=your_totp_secret_here

# ── Telegram Alerts ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Dhan Backup Feed (Optional) ──────────────────────────────────────
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ── App Settings ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
INITIAL_CAPITAL=10000
# LIVE_MONEY SAFETY: set to "yes" (NOT in .env) only when you intend real orders.
#   LIVE_CONFIRM=yes .venv/bin/python run_live_engine.py
# Launching the live engine without this flag refuses to boot.
